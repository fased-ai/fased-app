[Unit]
Description=Fased Custody Signer Daemon (Isolated Private Key & Policy Authority)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fased-signer
Group=fased-ipc
UMask=0077
RuntimeDirectory=fased-signer
RuntimeDirectoryMode=0750
StateDirectory=fased-signer
StateDirectoryMode=0700
LoadCredentialEncrypted=fased-signer-kek:/etc/credstore.encrypted/fased-signer-kek
ExecStart=/usr/local/bin/fased-app signer-daemon --data-dir /var/lib/fased-signer --socket /run/fased-signer/app.sock --socket-mode 0660 --allowed-app-user fased-app --owner-socket /run/fased-signer/owner.sock --require-os-kek --require-owner-auth
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/fased-signer /run/fased-signer

[Install]
WantedBy=multi-user.target
