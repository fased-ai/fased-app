{
  "type": "object",
  "properties": {
    "schema": {
      "const": "wen-strategy/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "market": {
      "$ref": "#/$defs/market"
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "allocation": {
      "$ref": "#/$defs/allocation"
    },
    "schedule": {
      "$ref": "#/$defs/schedule"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    }
  },
  "required": [
    "schema",
    "name",
    "description",
    "market",
    "research",
    "allocation",
    "schedule",
    "limits",
    "execution"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wen:strategy:1",
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "returnBps",
            "realizedVolBps"
          ]
        },
        "lookbackMinutes": {
          "type": "integer",
          "enum": [
            30,
            60,
            240,
            720,
            1440
          ]
        },
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "lte"
          ]
        },
        "valueBps": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 40
        }
      },
      "required": [
        "metric",
        "lookbackMinutes",
        "operator",
        "valueBps"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "networkGenesisHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "economyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assetMint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "termsHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "interfaceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "networkGenesisHash",
        "programId",
        "economyId",
        "assetMint",
        "termsHash",
        "interfaceVersion"
      ],
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "wide",
            "center",
            "trend-up",
            "trend-down",
            "tails",
            "custom"
          ]
        },
        "weightsBps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "minItems": 5,
          "maxItems": 5
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "conditional"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                },
                "maxItems": 32,
                "minItems": 1
              },
              "preset": {
                "type": "string",
                "enum": [
                  "wide",
                  "center",
                  "trend-up",
                  "trend-down",
                  "tails",
                  "custom"
                ]
              },
              "weightsBps": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "minItems": 5,
                "maxItems": 5
              }
            },
            "required": [
              "when",
              "preset",
              "weightsBps"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        }
      },
      "required": [
        "preset",
        "weightsBps",
        "mode",
        "rules"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "perRoundLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "totalTurnoverLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "dailyTurnoverLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maxUnsettledLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maxUserFeesLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maxUserFeesPerRoundLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "maxLossLamports": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "perRoundLamports",
        "totalTurnoverLamports",
        "dailyTurnoverLamports",
        "maxUnsettledLamports",
        "maxUserFeesLamports",
        "maxUserFeesPerRoundLamports",
        "maxLossLamports"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "startsAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "format": "date-time"
        },
        "everyNthRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 144
        },
        "anchorRound": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "utcWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMinute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439
              },
              "endMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              }
            },
            "required": [
              "startMinute",
              "endMinute"
            ],
            "additionalProperties": false
          },
          "maxItems": 1440
        },
        "selectedRoundIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "maxItems": 144,
          "uniqueItems": true
        },
        "skipRoundIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "maxItems": 144,
          "uniqueItems": true
        },
        "maxRoundsTotal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 144
        },
        "maxRoundsPerUtcDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 144
        },
        "cooldownRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 143
        },
        "randomSelection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "seedHex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 144
                }
              },
              "required": [
                "seedHex",
                "count"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "startsAt",
        "expiresAt",
        "everyNthRound",
        "anchorRound",
        "utcWindows",
        "selectedRoundIds",
        "skipRoundIds",
        "maxRoundsTotal",
        "maxRoundsPerUtcDay",
        "cooldownRounds",
        "randomSelection"
      ],
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "thesis": {
          "type": "string",
          "enum": [
            "trend",
            "consolidation",
            "reversal",
            "volatility",
            "custom"
          ]
        },
        "horizonMinutes": {
          "type": "integer",
          "enum": [
            30,
            60,
            240,
            720,
            1440
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "maxItems": 32
        },
        "outlook": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "probabilitiesBps": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "minItems": 5,
                  "maxItems": 5
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "user",
                    "model"
                  ]
                },
                "methodVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "asOf": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                  "format": "date-time"
                }
              },
              "required": [
                "probabilitiesBps",
                "source",
                "methodVersion",
                "asOf"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "thesis",
        "horizonMinutes",
        "conditions",
        "outlook"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "notify",
            "review",
            "bounded-auto"
          ]
        },
        "runner": {
          "type": "string",
          "enum": [
            "browser",
            "fased"
          ]
        },
        "mandateId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        }
      },
      "required": [
        "mode",
        "runner",
        "mandateId"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Additional exact-byte, u64/i128, sum, calendar, allocation minimum and relational validation is mandatory. A JSON Schema pass alone is not admission."
}
